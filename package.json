{
  "name": "aoc-boilerplate-ts",
  "version": "0.0.1",
  "description": "TypeScript boilerplate project for Advent of Code",
  "repository": "git@github.com:cserby/aoc-boilerplate-ts.git",
  "author": "Marton Cserbak <cserby@gmail.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.6",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.14.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
